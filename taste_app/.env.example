# Environment Configuration Template
# Copy this file to .env.development and .env.production and fill with your values

# Supabase Configuration (REQUIRED)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Maps API Configuration (REQUIRED)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Environment Configuration
ENVIRONMENT=development

# App Configuration
APP_CACHE_DURATION_MINUTES=5
APP_LOCATION_TIMEOUT_SECONDS=15
APP_DEBUG_MODE=true

# API Configuration
API_TIMEOUT_SECONDS=30
API_RETRY_MAX_ATTEMPTS=3
API_RETRY_DELAY_MS=1000

# CORS Proxy Configuration (for development only)
CORS_PROXY_HOST=localhost
CORS_PROXY_PORT=8080
USE_CORS_PROXY=false

# Debug Configuration
FLUTTER_DEBUG=true
SUPABASE_DEBUG=true
LOG_LEVEL=debug