import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';
import 'package:google_maps_flutter/google_maps_flutter.dart' as gmaps;
import '../../../core/theme/app_colors.dart';
import '../../../core/theme/app_text_styles.dart';
import '../../../core/theme/app_dimensions.dart';
import '../../../core/services/connectivity_service.dart';
import '../../../domain/entities/category.dart';
import '../../../data/models/category_model.dart';
import '../../../data/models/restaurant_model.dart';
import '../../../data/models/location_model.dart';
import '../../../data/repositories/restaurant_repository.dart';
import '../../../data/services/location_service.dart';
import '../../../presentation/providers/category_provider.dart';
import '../../widgets/enhanced_map_widget.dart';
import '../../widgets/widgets.dart';
import '../../widgets/debounced_search_field.dart';
import '../../widgets/connectivity_banner.dart';
import '../../widgets/enhanced_error_widget.dart';

/// Página principal (Home) conforme referências visuais
class HomePage extends ConsumerStatefulWidget {
  const HomePage({super.key});
  
  @override
  ConsumerState<HomePage> createState() => _HomePageState();
}

class _HomePageState extends ConsumerState<HomePage> {
  final TextEditingController _searchController = TextEditingController();
  final RestaurantRepository _restaurantRepository = RestaurantRepository();
  
  String? _selectedCategoryId;
  bool _isLoading = true;
  bool _isRefreshing = false;
  LocationModel? _currentLocation;
  
  List<RestaurantModel> _featuredRestaurants = [];
  List<RestaurantModel> _nearbyRestaurants = [];
  List<RestaurantModel> _recommendedRestaurants = [];
  
  @override
  void initState() {
    super.initState();
    _loadInitialData();
  }

  @override
  void dispose() {
    _searchController.dispose();
    super.dispose();
  }

  /// Atualiza os dados da página
  Future<void> _onRefresh() async {
    await _loadInitialData();
  }

  /// Carrega os dados iniciais da página
  Future<void> _loadInitialData() async {
    try {
      setState(() {
        _isLoading = true;
      });

      // Tentar obter localização atual
      try {
        final position = await LocationService.instance.getCurrentLocation();
        if (position != null) {
          _currentLocation = LocationModel(
            latitude: position.latitude,
            longitude: position.longitude,
            accuracy: position.accuracy,
            timestamp: position.timestamp,
          );
        }
      } catch (e) {
        debugPrint('Erro ao obter localização: $e');
      }

      // Carregar dados em paralelo
      final results = await Future.wait([
        _restaurantRepository.getFeaturedRestaurants(limit: 5),
        _currentLocation != null 
          ? _restaurantRepository.getNearbyRestaurants(
              latitude: _currentLocation!.latitude,
              longitude: _currentLocation!.longitude,
              limit: 10,
            )
          : _restaurantRepository.getRestaurants(limit: 10),
        _restaurantRepository.getRestaurants(limit: 15),
      ]);

      if (mounted) {
        setState(() {
          _featuredRestaurants = results[0] as List<RestaurantModel>;
          _nearbyRestaurants = results[1] as List<RestaurantModel>;
          _recommendedRestaurants = results[2] as List<RestaurantModel>;
          _isLoading = false;
        });
      }
    } catch (e) {
      debugPrint('Erro ao carregar dados iniciais: $e');
      if (mounted) {
        setState(() {
          _isLoading = false;
        });
        // Mostrar erro para o usuário
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Erro ao carregar dados: $e'),
            backgroundColor: AppColors.error,
          ),
        );
      }
    }
  }
  
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: ConnectivityBanner(
        child: RefreshIndicator(
          onRefresh: _onRefresh,
          child: _buildContent(),
        ),
      ),
    );
  }

  Widget _buildContent() {
    // Se estiver offline e não tiver dados em cache, mostrar erro
    if (ConnectivityService.instance.status == ConnectivityStatus.disconnected &&
        _featuredRestaurants.isEmpty &&
        _nearbyRestaurants.isEmpty &&
        _recommendedRestaurants.isEmpty &&
        !_isLoading) {
      return EnhancedErrorWidget(
        title: 'Sem conexão',
        message: 'Conecte-se à internet para ver os restaurantes',
        errorType: ErrorType.network,
        onRetry: _loadInitialData,
        enableAutoRetry: true,
        autoRetryDelay: const Duration(seconds: 5),
        maxRetryAttempts: 3,
      );
    }

    return CustomScrollView(
          slivers: [
          // Header com saudação
          SliverToBoxAdapter(
            child: HomeAppBar(
              userName: 'Usuário',
              onProfileTap: _onProfileTap,
              onNotificationTap: _onNotificationTap,
            ),
          ),
          
          // Campo de busca
          SliverToBoxAdapter(
            child: _buildSearchSection(),
          ),
          
          // Mapa
          SliverToBoxAdapter(
            child: _buildMapSection(),
          ),
          
          // Título das categorias
          SliverToBoxAdapter(
            child: _buildSectionTitle('Categorias'),
          ),
          
          // Grid de categorias
          SliverToBoxAdapter(
            child: Consumer(
              builder: (context, ref, child) {
                final categoriesAsync = ref.watch(activeCategoriesProvider);
                
                return categoriesAsync.when(
                  data: (categories) => CategoriesGrid(
                    categories: categories.map((category) => CategoryModel(
                      id: category.id,
                      name: category.name,
                      icon: category.icon,
                      color: category.color,
                      isActive: category.isActive,
                      sortOrder: category.sortOrder,
                      createdAt: category.createdAt,
                      updatedAt: category.updatedAt,
                    )).toList(),
                    selectedCategoryId: _selectedCategoryId,
                    onCategoryTap: _onCategoryTap,
                  ),
                  loading: () => const CategoriesGridSkeleton(),
                  error: (error, stack) => Center(
                    child: Text('Erro ao carregar categorias: $error'),
                  ),
                );
              },
            ),
          ),
          
          // Seção "Perto de você"
          SliverToBoxAdapter(
            child: NearbyRestaurantsSection(
              restaurants: _nearbyRestaurants,
              isLoading: _isLoading,
              title: 'Perto de você',
              onSeeAll: _onSeeAllNearbyRestaurants,
              onRestaurantTap: (restaurant) {
                debugPrint('Restaurante próximo selecionado: ${restaurant.name}');
              },
              onFavoriteToggle: (restaurant) {
                debugPrint('Toggle favorito: ${restaurant.name}');
              },
            ),
          ),
          
          const SliverToBoxAdapter(
            child: SizedBox(height: AppDimensions.paddingLarge),
          ),
          
          // Seção de restaurantes populares
          SliverToBoxAdapter(
            child: _isLoading 
                ? const HorizontalRestaurantListSkeleton()
                : RestaurantsHorizontalList(
                    restaurants: _featuredRestaurants,
                    title: 'Populares perto de você',
                    onSeeAll: () {
                      debugPrint('Ver todos os restaurantes populares');
                    },
                    onRestaurantTap: (restaurant) {
                      debugPrint('Restaurante selecionado: ${restaurant.name}');
                    },
                    onFavoriteChanged: (isFavorite) {
                      debugPrint('Favorito alterado');
                    },
                  ),
          ),
          
          const SliverToBoxAdapter(
            child: SizedBox(height: AppDimensions.paddingLarge),
          ),
          
          // Seção de recomendações
          SliverToBoxAdapter(
            child: _isLoading 
                ? const HorizontalRestaurantListSkeleton()
                : RestaurantsHorizontalList(
                    restaurants: _recommendedRestaurants.take(5).toList(),
                    title: 'Recomendados para você',
                    onSeeAll: () {
                      debugPrint('Ver todas as recomendações');
                    },
                    onRestaurantTap: (restaurant) {
                      debugPrint('Restaurante recomendado selecionado: ${restaurant.name}');
                    },
                    onFavoriteChanged: (isFavorite) {
                      debugPrint('Favorito alterado');
                    },
                  ),
          ),
          
          const SliverToBoxAdapter(
            child: SizedBox(height: AppDimensions.paddingLarge),
          ),
          
          // Seção de restaurantes recomendados
          SliverToBoxAdapter(
            child: Padding(
              padding: const EdgeInsets.symmetric(
                horizontal: AppDimensions.paddingMedium,
              ),
              child: Text(
                'Mais restaurantes',
                style: AppTextStyles.h2.copyWith(
                  color: AppColors.textDark,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ),
          
          const SliverToBoxAdapter(
            child: SizedBox(height: AppDimensions.paddingMedium),
          ),
          
          // Lista vertical de restaurantes
          _isLoading
              ? SliverList(
                  delegate: SliverChildBuilderDelegate(
                    (context, index) {
                      return const Padding(
                        padding: EdgeInsets.symmetric(
                          horizontal: AppDimensions.paddingMedium,
                        ),
                        child: RestaurantCardSkeleton(),
                      );
                    },
                    childCount: 3,
                  ),
                )
              : SliverList(
                  delegate: SliverChildBuilderDelegate(
                    (context, index) {
                      if (index < _recommendedRestaurants.length) {
                        final restaurant = _recommendedRestaurants[index];
                        return Padding(
                          padding: const EdgeInsets.symmetric(
                            horizontal: AppDimensions.paddingMedium,
                          ),
                          child: RestaurantCard(
                            restaurant: restaurant,
                            onTap: () {
                              debugPrint('Restaurante selecionado: ${restaurant.name}');
                            },
                            onFavoriteChanged: (isFavorite) {
                              debugPrint('Favorito alterado: ${restaurant.name}');
                            },
                          ),
                        );
                      }
                      return const SizedBox.shrink();
                    },
                    childCount: _recommendedRestaurants.length,
                  ),
                ),
          
          // Espaçamento final
          const SliverToBoxAdapter(
            child: SizedBox(height: AppDimensions.paddingXLarge),
          ),
        ],
      ),
    );
  }
  
  Widget _buildSearchSection() {
    return Container(
      padding: const EdgeInsets.all(AppDimensions.paddingMedium),
      child: DebouncedSearchField(
        controller: _searchController,
        hintText: 'Buscar restaurantes...',
        debounceDuration: const Duration(milliseconds: 500),
        onChanged: _onSearchChanged,
        onSubmitted: (value) {
          if (value.isNotEmpty) {
            context.push('/search?q=${Uri.encodeComponent(value)}');
          }
        },
        onClear: () {
          _searchController.clear();
        },
      ),
    );
  }
  
  Widget _buildMapSection() {
    return Container(
      margin: const EdgeInsets.symmetric(
        horizontal: AppDimensions.marginMedium,
      ),
      child: CompactMapWidget(
        initialPosition: gmaps.CameraPosition(
          target: _currentLocation != null
              ? gmaps.LatLng(_currentLocation!.latitude, _currentLocation!.longitude)
              : const gmaps.LatLng(-23.5505, -46.6333), // São Paulo como fallback
          zoom: 14.0,
        ),
        onTap: () {
          debugPrint('Abrir mapa completo');
          // Navegar para mapa completo
          // context.push('/map');
        },
        height: AppDimensions.mapHeight,
      ),
    );
  }
  
  Widget _buildSectionTitle(String title) {
    return Padding(
      padding: const EdgeInsets.fromLTRB(
        AppDimensions.paddingMedium,
        AppDimensions.paddingLarge,
        AppDimensions.paddingMedium,
        AppDimensions.paddingSmall,
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(
            title,
            style: AppTextStyles.h3.copyWith(
              color: AppColors.textPrimary,
            ),
          ),
          if (title == 'Restaurantes Próximos')
            TextButton(
              onPressed: _onSeeAllRestaurants,
              child: Text(
                'Ver todos',
                style: AppTextStyles.buttonTextSecondary,
              ),
            ),
        ],
      ),
    );
  }

  // Callbacks

  void _onSearchChanged(String value) {
    // Implementar busca
    debugPrint('Busca: $value');
  }
  
  void _onSearchTap() {
    // Navegar para tela de busca
    context.push('/search');
  }
  
  void _onCategoryTap(CategoryModel category) {
    setState(() {
      _selectedCategoryId = category.id;
    });
    
    debugPrint('Categoria selecionada: ${category.name}');
    
    // Navegar para página de categoria específica
    context.push('/category/${category.id}?name=${Uri.encodeComponent(category.name)}');
  }
  
  void _onProfileTap() {
    // Navegar para perfil
    debugPrint('Abrir perfil');
  }
  
  void _onNotificationTap() {
    // Abrir notificações
    debugPrint('Abrir notificações');
  }
  
  void _onSeeAllRestaurants() {
    // Navegar para lista completa
    debugPrint('Ver todos os restaurantes');
  }

  void _onSeeAllNearbyRestaurants() {
    // Navegar para lista de restaurantes próximos
    debugPrint('Ver todos os restaurantes próximos');
  }
}

/// Widget de seção da home page
class HomeSection extends StatelessWidget {
  final String title;
  final Widget child;
  final String? actionText;
  final VoidCallback? onActionTap;
  final EdgeInsetsGeometry? padding;
  
  const HomeSection({
    super.key,
    required this.title,
    required this.child,
    this.actionText,
    this.onActionTap,
    this.padding,
  });
  
  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: padding ?? const EdgeInsets.all(AppDimensions.paddingMedium),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text(
                title,
                style: AppTextStyles.h3.copyWith(
                  color: AppColors.textPrimary,
                ),
              ),
              if (actionText != null && onActionTap != null)
                TextButton(
                  onPressed: onActionTap,
                  child: Text(
                    actionText!,
                    style: AppTextStyles.buttonTextSecondary,
                  ),
                ),
            ],
          ),
          const SizedBox(height: AppDimensions.paddingMedium),
          child,
        ],
      ),
    );
  }
}

/// Widget de mapa compacto para a home
class CompactMapWidget extends StatelessWidget {
  final gmaps.CameraPosition initialPosition;
  final Set<gmaps.Marker>? markers;
  final VoidCallback? onTap;
  final double height;
  
  const CompactMapWidget({
    super.key,
    required this.initialPosition,
    this.markers,
    this.onTap,
    this.height = AppDimensions.mapHeight,
  });
  
  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        height: height,
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(AppDimensions.cardRadius),
          boxShadow: [
            BoxShadow(
              color: Colors.black.withOpacity(0.1),
              blurRadius: 8,
              offset: const Offset(0, 4),
            ),
          ],
        ),
        child: ClipRRect(
          borderRadius: BorderRadius.circular(AppDimensions.cardRadius),
          child: SafeGoogleMap(
            height: height,
            fallbackMessage: 'Mapa não disponível',
            mapWidget: gmaps.GoogleMap(
              initialCameraPosition: initialPosition,
              markers: markers ?? {},
              zoomControlsEnabled: false,
              scrollGesturesEnabled: false,
              zoomGesturesEnabled: false,
              tiltGesturesEnabled: false,
              rotateGesturesEnabled: false,
              mapToolbarEnabled: false,
              myLocationButtonEnabled: false,
            ),
          ),
        ),
      ),
    );
  }
}