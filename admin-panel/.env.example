# Admin Panel Environment Configuration Template
# Copy this file to .env.local and fill with your values

# Supabase Configuration (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NextAuth Configuration (REQUIRED)
NEXTAUTH_SECRET=your_random_secret_key_here_minimum_32_characters
NEXTAUTH_URL=http://localhost:3000

# Google Maps API (Optional - for geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Environment
NODE_ENV=development